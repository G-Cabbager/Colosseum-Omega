{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++.exe 编译当前文件",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++11",
                "${file}",
                "-o",
